# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-papergraph-build/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - never commit a filled one; the *.example files are checked in
.env*
!.env.example
!.env.production.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# downloaded sources for scripts/build-institution-domains.ts
/.cache/

# Claude Code local state and worktrees
.claude/

# local copy of the research database (seed input)
/data/

# Local working notes, never committed
.notes/
.scratch/
